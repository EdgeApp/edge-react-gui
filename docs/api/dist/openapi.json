                    },
                    "testMode": {
                      "type": "boolean",
                      "description": "True when pointed at the tester fleet."
                    },
                    "idleShutdownAt": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "When the engine will exit for want of work. Null while a session or a subscription is holding it open, and null when the timeout is disabled."
