                      ],
                      "description": "The loopback port, null unless started with `--tcp`."
                    },
                    "socketPath": {
                      "type": "string",
                      "description": "Unix socket the CLI connects to."
                    },
                    "locale": {
                      "type": "string",
                      "description": "Language tag the engine resolved at boot."
                    },
                    "decimalSeparator": {
