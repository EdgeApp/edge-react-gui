{
  "name": "react-native-zcash",
  "version": "0.13.2",
  "description": "Zcash library for React Native",
  "homepage": "https://github.com/EdgeApp/react-native-zcash",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/EdgeApp/react-native-zcash.git"
  },
  "license": "MIT",
  "author": "Airbitz, Inc.",
  "contributors": [
    "William Swanson <william@edge.app>",
    "Paul Puey <paul@edge.app>",
    "Matthew Piché <matthew@edge.app>",
    "Kevin Gorham <kevin.gorham@z.cash>"
  ],
  "main": "lib/rnzcash.rn.js",
  "types": "lib/src/react-native.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/react-native.d.ts",
      "default": "./lib/rnzcash.rn.js"
    },
    "./node": {
      "types": "./lib/src/node.d.ts",
      "default": "./lib/src/node.js"
    },
    "./rn": {
      "types": "./lib/src/react-native.d.ts",
      "default": "./lib/rnzcash.rn.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "node": [
        "lib/src/node.d.ts"
      ]
    }
  },
  "files": [
    "/android/build.gradle",
    "/android/src/",
    "/CHANGELOG.md",
    "/ios/",
    "/lib/",
    "/LICENSE",
    "/node.d.ts",
    "/node.js",
    "/package.json",
    "/prebuilds/",
    "/react-native-zcash.podspec",
    "/README.md",
    "/src/"
  ],
  "scripts": {
    "build": "(cd android && gradle assemble -DheapDumpOnOutOfMemoryError=false)",
    "build-native-host": "node -r sucrase/register ./scripts/build-native-host.ts",
    "build-native-android": "node -r sucrase/register ./scripts/build-native-android.ts",
    "build-native-ios": "node -r sucrase/register ./scripts/build-native-ios.ts",
    "fix-kotlin": "ktlint --format 'android/src/**/*.kt'",
    "fix-swift": "swift-format format -i ios/RNZcash.swift ios/EdgeZcashClient.swift",
    "fix": "npm run lint -- --fix",
    "lint": "eslint .",
    "smoke-node": "node -r sucrase/register ./scripts/smoke-node.ts"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint"
  },
  "dependencies": {
    "biggystring": "^4.2.3",
    "rfc4648": "^1.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.9.6",
    "@babel/plugin-transform-object-assign": "^7.8.3",
    "@babel/preset-env": "^7.9.6",
    "@babel/preset-typescript": "^7.9.0",
    "@grpc/grpc-js": "^1.8.22",
    "@types/node": "^14.0.5",
    "@types/react-native": "^0.62.11",
    "@typescript-eslint/eslint-plugin": "^2.34.0",
    "@typescript-eslint/parser": "^3.0.1",
    "babel-eslint": "^10.1.0",
    "disklet": "^0.4.6",
    "eslint": "^7.15.0",
    "eslint-config-standard-kit": "^0.14.4",
    "eslint-plugin-flowtype": "^5.1.0",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-prettier": "^3.1.3",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-simple-import-sort": "^5.0.3",
    "eslint-plugin-standard": "^4.0.1",
    "husky": "^7.0.0",
    "lint-staged": "^10.2.6",
    "prettier": "^2.0.5",
    "rimraf": "^3.0.2",
    "rollup": "^2.80.0",
    "rollup-plugin-babel": "^4.4.0",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-flow-entry": "^0.3.4",
    "rollup-plugin-node-resolve": "^5.2.0",
    "sucrase": "^3.15.0",
    "typescript": "^3.9.3"
  },
  "peerDependencies": {
    "react-native": ">=0.47.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  }
}
