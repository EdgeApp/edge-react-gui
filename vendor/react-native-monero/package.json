{
  "name": "react-native-monero",
  "version": "0.5.0",
  "description": "React Native bindings for the monero-lwsf library",
  "homepage": "https://github.com/EdgeApp/react-native-monero",
  "repository": {
    "type": "git",
    "url": "git@github.com:EdgeApp/react-native-monero.git"
  },
  "license": "BSD-3-Clause",
  "author": "Airbitz, Inc.",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./rn": {
      "types": "./lib/src/rn.d.ts",
      "default": "./lib/src/rn.js"
    },
    "./node": {
      "types": "./lib/src/node.d.ts",
      "default": "./lib/src/node.js"
    },
    "./lib/src/CppBridge": {
      "types": "./lib/src/CppBridge.d.ts",
      "default": "./lib/src/CppBridge.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "node": [
        "lib/src/node.d.ts"
      ],
      "rn": [
        "lib/src/rn.d.ts"
      ]
    }
  },
  "files": [
    "/android/build.gradle",
    "/android/src/",
    "/CHANGELOG.md",
    "/ios/",
    "/lib/src/",
    "/node.d.ts",
    "/node.js",
    "/package.json",
    "/prebuilds/",
    "/rn.d.ts",
    "/rn.js",
    "/react-native-monero.podspec",
    "/README.md",
    "/src/monero-wrapper/monero-methods.hpp",
    "/src/node/"
  ],
  "lint-staged": {
    "*.{js,ts}": "eslint"
  },
  "scripts": {
    "clean": "npm run clean:js && rm -rf tmp android/src/main/jniLibs ios/MoneroModule.xcframework",
    "clean:js": "rm -rf node_modules lib",
    "fix": "npm run lint -- --fix",
    "lint": "eslint .",
    "build-native": "ZERO_AR_DATE=1 node -r sucrase/register ./scripts/build-native.ts",
    "build-native-host": "ZERO_AR_DATE=1 node -r sucrase/register ./scripts/build-native.ts host"
  },
  "dependencies": {
    "cleaners": "^0.3.17",
    "node-addon-api": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "eslint-config-standard-kit": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "node-gyp": "^11.4.2",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "sucrase": "^3.35.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react-native": ">=0.47.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  }
}
